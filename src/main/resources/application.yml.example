spring:
  application:
    name: deluxe-eterno
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:dev}
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/deluxe_eterno?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
  jpa:
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
  servlet:
    multipart:
      max-file-size: 6MB
      max-request-size: 7MB

server:
  port: ${PORT:8080}

app:
  demo:
    available: ${DEMO_AVAILABLE:true}
  media:
    directory: ${MEDIA_DIRECTORY:./uploads}
  inquiries:
    rate-limit:
      max-attempts: ${INQUIRY_RATE_LIMIT_MAX_ATTEMPTS:5}
      window: ${INQUIRY_RATE_LIMIT_WINDOW:10m}
  admin:
    username: ${ADMIN_USERNAME:admin}
    password: ${ADMIN_PASSWORD:}
